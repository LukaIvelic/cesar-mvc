@using System.Globalization
@{
    var fieldName = ViewData["FieldName"]?.ToString() ?? "Date";
    var label = ViewData["Label"]?.ToString() ?? "Date and time";
    var value = ViewData["Value"] is DateTime dateValue ? dateValue : DateTime.Now;
    var requiredMessage = ViewData["RequiredMessage"]?.ToString() ?? $"{label} is required.";
    var attemptedValue = ViewData.ModelState.TryGetValue(fieldName, out var state) ? state.AttemptedValue : null;
    var culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var format = culture == "hr" ? "dd.MM.yyyy. HH:mm" : "MM/dd/yyyy HH:mm";
    var displayValue = string.IsNullOrWhiteSpace(attemptedValue)
        ? value.ToString(format, CultureInfo.CurrentCulture)
        : attemptedValue;
}

<div class="relative" data-date-time-control>
    <label for="@fieldName" class="block text-sm font-medium mb-1">@label</label>
    <div class="flex gap-2">
        <input id="@fieldName"
               name="@fieldName"
               type="text"
               value="@displayValue"
               autocomplete="off"
               class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black"
               data-date-time-input
               data-val="true"
               data-val-required="@requiredMessage" />
        <button type="button"
                class="btn-secondary"
                data-date-time-toggle>
            Pick
        </button>
    </div>
    <span class="text-red-500 text-xs mt-1 block" data-valmsg-for="@fieldName" data-valmsg-replace="true"></span>

    <div class="absolute z-30 mt-2 w-72 bg-white border border-[#d8e0ea] rounded shadow-sm p-3 hidden" data-date-time-panel>
        <div class="flex items-center justify-between mb-3">
            <button type="button" class="btn-ghost" data-date-time-prev>Prev</button>
            <strong class="text-sm" data-date-time-title></strong>
            <button type="button" class="btn-ghost" data-date-time-next>Next</button>
        </div>
        <div class="grid grid-cols-7 gap-1 text-center text-xs text-neutral-500 mb-1">
            <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
        </div>
        <div class="grid grid-cols-7 gap-1" data-date-time-days></div>
        <div class="flex items-center gap-2 mt-3">
            <label class="text-xs text-neutral-500" for="@($"{fieldName}_Hour")">Time</label>
            <input id="@($"{fieldName}_Hour")" type="number" min="0" max="23" class="w-16 border border-[#d0d0d0] rounded px-2 py-1 text-sm" data-date-time-hour />
            <span>:</span>
            <input type="number" min="0" max="59" class="w-16 border border-[#d0d0d0] rounded px-2 py-1 text-sm" data-date-time-minute />
            <button type="button" class="btn-ghost ml-auto" data-date-time-now>Now</button>
        </div>
    </div>
</div>
