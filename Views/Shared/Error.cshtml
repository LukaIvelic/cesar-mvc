@model cesar.Features.Home.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-shell page-shell-medium">
    <div class="detail-panel">
        <span class="badge">Request failed</span>
        <h1 class="page-title mt-4">Error</h1>
        <p class="page-subtitle">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <div class="meta-item mt-5">
                <span class="meta-label">Request ID</span>
                <p class="meta-value font-mono">@Model.RequestId</p>
            </div>
        }

        <div class="mt-6 border-t border-[#d8e0ea] pt-5">
            <h2 class="section-title">Development Mode</h2>
            <p class="text-sm text-neutral-600 mt-2">
                Swapping to the Development environment will display more detailed information about the error that occurred.
            </p>
            <p class="text-sm text-neutral-600 mt-2">
                The Development environment should not be enabled for deployed applications because it can display sensitive information from exceptions.
            </p>
        </div>
    </div>
</div>
