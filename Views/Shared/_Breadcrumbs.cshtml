@{
    // Breadcrumb data structure: List of (label, controller, action, routeValues)
    // Set in controller via: ViewData["Breadcrumbs"] = new List<(string label, string controller, string action)> { ... }
    var breadcrumbs = ViewData["Breadcrumbs"] as List<(string label, string controller, string action)>;
    var currentPage = ViewData["CurrentPage"] as string;
}

@if (breadcrumbs != null && breadcrumbs.Count > 0)
{
    <nav class="text-sm text-neutral-500 mb-4">
        <a asp-controller="Home" asp-action="Index" class="hover:underline">Home</a>
        @foreach (var crumb in breadcrumbs)
        {
            <span class="mx-1">›</span>
            @if (crumb == breadcrumbs.Last())
            {
                <span class="text-neutral-900 font-medium">@crumb.label</span>
            }
            else
            {
                <a asp-controller="@crumb.controller" asp-action="@crumb.action" class="hover:underline">@crumb.label</a>
            }
        }
    </nav>
}
else if (!string.IsNullOrEmpty(currentPage) && currentPage != "Home")
{
    <nav class="text-sm text-neutral-500 mb-4">
        <a asp-controller="Home" asp-action="Index" class="hover:underline">Home</a>
        <span class="mx-1">›</span>
        <span class="text-neutral-900 font-medium">@currentPage</span>
    </nav>
}
