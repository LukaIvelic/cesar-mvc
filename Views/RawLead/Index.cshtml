@model IEnumerable<cesar.Features.RawLead.Models.RawLeadViewModel>

@{
    var columns = new[] { "ID", "Source System", "External ID", "Ingested At", "Valid From", "Actions" };
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-semibold">Raw Leads</h2>
        <a asp-action="Create" class="bg-black text-white text-sm px-4 py-2 rounded hover:bg-neutral-800 transition">
            + Add Lead
        </a>
    </div>

    <div class="mb-4">
        <label for="raw-lead-search" class="block text-sm font-medium mb-1">Search raw leads</label>
        <input id="raw-lead-search"
               type="search"
               class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black"
               placeholder="Search by source, external ID or JSON"
               data-ajax-search
               data-ajax-url="@Url.Action("Search", "RawLead")"
               data-ajax-target="#raw-lead-rows" />
    </div>

    <table class="w-full border-collapse">
        <thead>
            <tr>
                @foreach (var column in columns)
                {
                    <th class="bg-[#efefef] border border-[#d0d0d0] px-4 py-2 text-left text-sm font-semibold">@column</th>
                }
            </tr>
        </thead>
        <tbody id="raw-lead-rows">
            @await Html.PartialAsync("_Rows", Model)
        </tbody>
    </table>
</div>
