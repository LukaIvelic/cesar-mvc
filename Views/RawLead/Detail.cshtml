@model cesar.Features.RawLead.Models.RawLeadDetailViewModel

<div class="page-shell page-shell-medium">
    <div class="page-header">
        <div>
            <p class="page-kicker">Lead detail</p>
            <h2 class="page-title">Lead #@Model.Id</h2>
            <p class="page-subtitle">Inspect the original JSON payload and source metadata.</p>
        </div>
        <a asp-action="Index" class="back-link">Back to list</a>
    </div>

    <div class="detail-panel mb-6">
        <div class="meta-grid">
            <div class="meta-item">
                <span class="meta-label">Source System</span>
                <p class="meta-value">@Model.SourceSystem</p>
            </div>
            <div class="meta-item">
                <span class="meta-label">External ID</span>
                <p class="meta-value font-mono">@Model.ExternalId</p>
            </div>
            <div class="meta-item">
                <span class="meta-label">Ingested At</span>
                <p class="meta-value">@Model.IngestedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
            </div>
            <div class="meta-item">
                <span class="meta-label">Valid From</span>
                <p class="meta-value">@Model.ValidFrom.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
            </div>
        </div>
    </div>

    <div class="mb-4 flex items-center justify-between gap-3">
        <h3 class="section-title">Raw JSON</h3>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary">Edit Lead</a>
    </div>

    <pre class="code-block text-sm font-mono overflow-x-auto whitespace-pre-wrap">@Model.RawJsonData</pre>
</div>
