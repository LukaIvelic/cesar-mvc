@model IEnumerable<cesar.Features.RawLead.Models.RawLeadViewModel>

@if (!Model.Any())
{
    <tr>
        <td colspan="6" class="empty-cell">No raw leads found.</td>
    </tr>
}
else
{
    @foreach (var lead in Model)
    {
        <tr>
            <td>@lead.Id</td>
            <td>@lead.SourceSystem</td>
            <td class="font-mono">@lead.ExternalId</td>
            <td>@lead.IngestedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@lead.ValidFrom.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                <div class="action-row">
                    <a asp-action="Detail" asp-route-id="@lead.Id" class="link-primary">View JSON</a>
                    <a asp-action="Edit" asp-route-id="@lead.Id" class="link-muted">Edit</a>
                    <form asp-action="Delete" asp-route-id="@lead.Id" method="post" onsubmit="return confirm('Soft delete this lead?')">
                        <button type="submit" class="link-danger">Delete</button>
                    </form>
                </div>
            </td>
        </tr>
    }
}
