@model IEnumerable<cesar.Features.Weather.Models.WeatherForecastViewModel>

@{
    var columns = new[] { "Date", "Temperature", "Summary", "Actions" };
}

<div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-semibold">Weather Forecasts</h2>
        <a asp-action="Create" class="bg-black text-white text-sm px-4 py-2 rounded hover:bg-neutral-800 transition">
            + Add Forecast
        </a>
    </div>

    <div class="mb-4">
        <label for="weather-search" class="block text-sm font-medium mb-1">Search forecasts</label>
        <input id="weather-search"
               type="search"
               class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black"
               placeholder="Search by date, temperature or summary"
               data-ajax-search
               data-ajax-url="@Url.Action("Search", "WeatherForecast")"
               data-ajax-target="#weather-rows" />
    </div>

    <table class="w-full border-collapse">
        <thead>
            <tr>
                @foreach (var column in columns)
                {
                    <th class="bg-[#efefef] border border-[#d0d0d0] px-4 py-2 text-left font-semibold">@column</th>
                }
            </tr>
        </thead>
        <tbody id="weather-rows">
            @await Html.PartialAsync("_Rows", Model)
        </tbody>
    </table>
</div>
