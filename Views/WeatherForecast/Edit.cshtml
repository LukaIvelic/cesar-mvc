@model cesar.Features.Weather.Models.EditWeatherForecastModel

<div class="max-w-xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-semibold">Edit Forecast #@Model.Id</h2>
        <a asp-action="Index" class="text-sm text-neutral-500 hover:underline">Back to list</a>
    </div>

    <form asp-action="Edit" method="post" class="flex flex-col gap-8">
        <input type="hidden" asp-for="Id" />

        @await Html.PartialAsync("_DateTimePicker", null, new ViewDataDictionary(ViewData)
        {
            ["FieldName"] = nameof(Model.Date),
            ["Label"] = "Forecast date and time",
            ["Value"] = Model.Date,
            ["RequiredMessage"] = "Forecast date and time are required."
        })

        <div>
            <label asp-for="TemperatureC" class="block text-sm font-medium mb-1">Temperature (C)</label>
            <input asp-for="TemperatureC" type="number" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black" />
            <span asp-validation-for="TemperatureC" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Summary" class="block text-sm font-medium mb-1"></label>
            <input asp-for="Summary" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black" />
            <span asp-validation-for="Summary" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <button type="submit" class="bg-black text-white text-sm px-4 py-2 rounded hover:bg-neutral-800 transition self-start">
            Save Changes
        </button>
    </form>
</div>
