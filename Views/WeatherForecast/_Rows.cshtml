@model IEnumerable<cesar.Features.Weather.Models.WeatherForecastViewModel>

@if (!Model.Any())
{
    <tr>
        <td colspan="4" class="empty-cell">No forecasts found.</td>
    </tr>
}
else
{
    @foreach (var forecast in Model)
    {
        <tr>
            <td>@forecast.Date</td>
            <td>@forecast.TemperatureDisplay</td>
            <td>@forecast.Summary</td>
            <td>
                <div class="action-row">
                    <a asp-action="Edit" asp-route-id="@forecast.Id" class="link-muted">Edit</a>
                    <form asp-action="Delete" asp-route-id="@forecast.Id" method="post" onsubmit="return confirm('Delete this forecast?')">
                        <button type="submit" class="link-danger">Delete</button>
                    </form>
                </div>
            </td>
        </tr>
    }
}
