@{
    ViewData["Title"] = "Overview";
}

<div class="page-shell">
    <section class="dashboard-hero">
        <div class="dashboard-hero-content">
            <div>
                <p class="page-kicker">Overview</p>
                <h1 class="hero-title">Lead processing workspace</h1>
                <p class="hero-copy">
                    Review incoming lead payloads, track recurring JSON fields, manage analysis records, and preview output templates.
                </p>
            </div>

            <div class="hero-metrics">
                <a asp-controller="RawLead" asp-action="Index" class="hero-metric">
                    <span>Input data</span>
                    <strong>Raw leads</strong>
                </a>
                <a asp-controller="JsonKeyStat" asp-action="Index" class="hero-metric">
                    <span>Schema tracking</span>
                    <strong>JSON keys</strong>
                </a>
                <a asp-controller="LeadIntelligence" asp-action="Index" class="hero-metric">
                    <span>Analysis</span>
                    <strong>Lead intelligence</strong>
                </a>
                <a asp-controller="DesignTemplate" asp-action="Index" class="hero-metric">
                    <span>Output</span>
                    <strong>Templates</strong>
                </a>
            </div>
        </div>
    </section>

    <div class="dashboard-grid">
        <section class="dashboard-panel span-8">
            <div class="section-heading">
                <div>
                    <p class="page-kicker">Workflow</p>
                    <h2 class="section-title">How records move through the app</h2>
                </div>
            </div>

            <div class="pipeline-list">
                <a asp-controller="RawLead" asp-action="Index" class="pipeline-step">
                    <span class="pipeline-step-index">1</span>
                    <strong>Store raw payloads</strong>
                    <span>Keep source-system JSON records available for review and search.</span>
                </a>
                <a asp-controller="JsonKeyStat" asp-action="Index" class="pipeline-step">
                    <span class="pipeline-step-index">2</span>
                    <strong>Track useful fields</strong>
                    <span>Record recurring keys that can become template placeholders.</span>
                </a>
                <a asp-controller="LeadIntelligence" asp-action="Index" class="pipeline-step">
                    <span class="pipeline-step-index">3</span>
                    <strong>Review scores</strong>
                    <span>Compare content hashes, familiarity, and density values.</span>
                </a>
                <a asp-controller="DesignTemplate" asp-action="Index" class="pipeline-step">
                    <span class="pipeline-step-index">4</span>
                    <strong>Render output</strong>
                    <span>Preview templates against saved lead JSON before using them.</span>
                </a>
            </div>
        </section>

        <aside class="dashboard-panel span-4">
            <p class="page-kicker">Create</p>
            <h2 class="section-title mb-4">Common actions</h2>
            <div class="quick-link-list">
                <a asp-controller="RawLead" asp-action="Create" class="quick-link">
                    <span>Add raw lead</span>
                    <span>Create</span>
                </a>
                <a asp-controller="LeadIntelligence" asp-action="Create" class="quick-link">
                    <span>Add intelligence record</span>
                    <span>Create</span>
                </a>
                <a asp-controller="DesignTemplate" asp-action="Create" class="quick-link">
                    <span>Create template</span>
                    <span>Create</span>
                </a>
                <a asp-controller="JsonKeyStat" asp-action="Create" class="quick-link">
                    <span>Track JSON key</span>
                    <span>Create</span>
                </a>
            </div>
        </aside>

        <section class="dashboard-panel span-12">
            <div class="section-heading">
                <div>
                    <p class="page-kicker">Sections</p>
                    <h2 class="section-title">Main areas</h2>
                </div>
            </div>

            <div class="use-case-grid">
                <a asp-controller="RawLead" asp-action="Index" class="use-case">
                    <span class="section-label">Raw leads</span>
                    <strong>Search source records</strong>
                    <p>Find payloads by source, external ID, timestamp, or JSON content.</p>
                </a>
                <a asp-controller="DesignTemplate" asp-action="Index" class="use-case">
                    <span class="section-label">Templates</span>
                    <strong>Manage rendered output</strong>
                    <p>Edit markup, placeholder schemas, previews, and attachments.</p>
                </a>
                <a asp-controller="LeadIntelligence" asp-action="Index" class="use-case">
                    <span class="section-label">Intelligence</span>
                    <strong>Review analysis data</strong>
                    <p>Check density, familiarity, and content hashes linked to leads.</p>
                </a>
            </div>
        </section>
    </div>
</div>
