@model cesar.Features.Identity.Models.LoginModel
@using cesar.Features.Identity.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager

@{
    ViewData["Title"] = "Log in";
    var externalProviders = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
    var googleProvider = externalProviders.FirstOrDefault(provider =>
        string.Equals(provider.Name, "Google", StringComparison.OrdinalIgnoreCase));
    var otherExternalProviders = externalProviders
        .Where(provider => !string.Equals(provider.Name, "Google", StringComparison.OrdinalIgnoreCase))
        .ToList();
}

<div class="page-shell page-shell-narrow">
    <div class="page-header">
        <div>
            <p class="page-kicker">Account</p>
            <h2 class="page-title">Log in</h2>
            <p class="page-subtitle">Access protected lead, template, and API management actions.</p>
        </div>
    </div>

    <form asp-action="Login" method="post" class="form-panel field-stack">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium mb-1"></label>
            <input asp-for="Email" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black" />
            <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium mb-1"></label>
            <input asp-for="Password" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black" />
            <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <label class="flex items-center gap-2 text-sm text-neutral-700">
            <input asp-for="RememberMe" class="rounded border-[#d0d0d0]" />
            Remember me
        </label>

        <button type="submit" class="btn-primary">Log in</button>
    </form>

    <div class="form-panel mt-6 field-stack">
        <div>
            <p class="section-label mb-2">Google Sign-In</p>
            @if (googleProvider is not null)
            {
                <form asp-action="ExternalLogin" method="post">
                    <input type="hidden" name="provider" value="@googleProvider.Name" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn-secondary w-full">
                        Continue with Google
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn-secondary w-full" disabled>
                    Google Sign-In not configured
                </button>
                <p class="text-xs text-neutral-500 mt-2">
                    Configure <span class="font-mono">Authentication:Google:ClientId</span> and
                    <span class="font-mono">Authentication:Google:ClientSecret</span> to enable this button.
                </p>
            }
        </div>

        @if (otherExternalProviders.Any())
        {
            <div>
                <p class="section-label mb-3">Other external login</p>
                @foreach (var provider in otherExternalProviders)
                {
                <form asp-action="ExternalLogin" method="post" class="mb-2">
                    <input type="hidden" name="provider" value="@provider.Name" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn-secondary w-full">
                        Continue with @provider.DisplayName
                    </button>
                </form>
                }
            </div>
            }
    </div>

    <p class="mt-6 text-sm text-neutral-600">
        No account?
        <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-primary">Register</a>
    </p>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
