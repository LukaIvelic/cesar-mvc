@model IEnumerable<cesar.Features.DesignTemplates.Models.DesignTemplateViewModel>

@if (!Model.Any())
{
    <tr>
        <td colspan="6" class="empty-cell">No templates found.</td>
    </tr>
}
else
{
    @foreach (var template in Model)
    {
        <tr class="align-top">
            <td>@template.Id</td>
            <td class="font-medium">@template.Name</td>
            <td><span class="badge">@template.ContentType</span></td>
            <td class="text-xs font-mono whitespace-pre-wrap max-w-sm">@template.PlaceholderSchema</td>
            <td>
                <a asp-action="Preview" asp-route-id="@template.Id" class="link-primary">Open preview</a>
            </td>
            <td>
                <div class="action-row">
                    <a asp-action="Preview" asp-route-id="@template.Id" class="link-primary">Preview</a>
                    <a asp-action="Edit" asp-route-id="@template.Id" class="link-muted">Edit</a>
                    <form asp-action="Delete" asp-route-id="@template.Id" method="post" onsubmit="return confirm('Soft delete this template?')">
                        <button type="submit" class="link-danger">Delete</button>
                    </form>
                </div>
            </td>
        </tr>
    }
}
