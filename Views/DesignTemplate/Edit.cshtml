@model cesar.Features.DesignTemplates.Models.EditDesignTemplateModel
@using System.Text.Json

<div class="page-shell">
    <div class="page-header">
        <div>
            <p class="page-kicker">Rendering</p>
            <h2 class="page-title">Edit Template #@Model.Id</h2>
            <p class="page-subtitle">Refine markup, validate JSON placeholders, and manage attached files.</p>
        </div>
        <a asp-action="Index" class="back-link">Back to list</a>
    </div>

    <form asp-action="Edit" method="post" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <input type="hidden" asp-for="Id" />

        <div class="form-panel field-stack">
            <div>
                <label asp-for="Name" class="block text-sm font-medium mb-1">Name</label>
                <input asp-for="Name" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black" />
                <span asp-validation-for="Name" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ContentType" class="block text-sm font-medium mb-1">Content Type</label>
                <select asp-for="ContentType" asp-items="Html.GetEnumSelectList<cesar.Features.DesignTemplates.Entities.ContentType>()" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black"></select>
                <span asp-validation-for="ContentType" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="PlaceholderSchema" class="block text-sm font-medium mb-1">Placeholder Schema (JSON)</label>
                <textarea asp-for="PlaceholderSchema" rows="9" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm font-mono focus:outline-none focus:border-black resize-y"></textarea>
                <span asp-validation-for="PlaceholderSchema" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="HtmlMarkup" class="block text-sm font-medium mb-1">HTML Markup</label>
                <textarea asp-for="HtmlMarkup" rows="14" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm font-mono focus:outline-none focus:border-black resize-y"></textarea>
                <span asp-validation-for="HtmlMarkup" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div class="form-panel field-stack">
            <div>
                <label class="block text-sm font-medium mb-1">Use Raw Lead JSON</label>
                <div class="flex gap-2">
                    <select id="raw-json-select" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black">
                        <option value="">Select lead JSON</option>
                        @foreach (var option in Model.RawJsonOptions)
                        {
                            <option value="@option.Id">@option.Label</option>
                        }
                    </select>
                    <button id="inject-json-btn" type="button" class="btn-secondary">Inject</button>
                </div>
            </div>

            <div>
                <label asp-for="PreviewRawJsonData" class="block text-sm font-medium mb-1">Preview Raw JSON</label>
                <textarea asp-for="PreviewRawJsonData" rows="12" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm font-mono focus:outline-none focus:border-black resize-y"></textarea>
                <span asp-validation-for="PreviewRawJsonData" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <p class="section-label mb-2">Injected values preview</p>
                <div id="injected-preview" class="preview-panel min-h-[220px] overflow-auto"></div>
            </div>

            <div class="action-row">
                <button type="submit" class="btn-primary">Save Changes</button>
                <button type="submit" formaction="@Url.Action("PreviewDraft", "DesignTemplate")" formmethod="post" formtarget="_blank" class="btn-secondary">Preview Draft</button>
                <a asp-action="Preview" asp-route-id="@Model.Id" class="btn-secondary">Open Saved Preview</a>
            </div>

            <p class="text-xs text-neutral-500">Preview uses <span class="font-mono">{{key}}</span> and <span class="font-mono">{{parent.child}}</span> placeholders.</p>
        </div>
    </form>

    <section class="dashboard-panel mt-6">
        <div class="flex items-center justify-between gap-4 mb-4">
            <div>
                <p class="page-kicker">Attachments</p>
                <h3 class="section-title">Files</h3>
            </div>
            <input id="attachment-input" type="file" multiple class="hidden" />
        </div>

        <div id="attachment-dropzone"
             class="border border-dashed border-[#a8a8a8] rounded p-6 text-center text-sm text-neutral-600 cursor-pointer hover:bg-neutral-50 transition">
            Drop files here or click to upload
        </div>

        <p id="attachment-status" class="text-sm text-neutral-500 mt-3"></p>
        <div id="attachment-list" class="mt-4"></div>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            const payload = @Html.Raw(JsonSerializer.Serialize(Model.RawJsonOptions.ToDictionary(x => x.Id.ToString(), x => x.RawJsonData)));
            const select = document.getElementById('raw-json-select');
            const button = document.getElementById('inject-json-btn');
            const target = document.getElementById('PreviewRawJsonData');
            const markup = document.getElementById('HtmlMarkup');
            const preview = document.getElementById('injected-preview');

            function getCaseInsensitive(obj, key) {
                if (!obj || typeof obj !== 'object') return undefined;
                const exact = obj[key];
                if (exact !== undefined) return exact;
                const foundKey = Object.keys(obj).find(k => k.toLowerCase() === key.toLowerCase());
                return foundKey ? obj[foundKey] : undefined;
            }

            function resolvePath(source, path) {
                return path.split('.').reduce((acc, part) => getCaseInsensitive(acc, part), source);
            }

            function renderPreview() {
                if (!preview || !markup || !target) return;

                let data;
                try {
                    data = JSON.parse(target.value || '{}');
                } catch {
                    preview.textContent = 'Invalid JSON in Preview Raw JSON.';
                    return;
                }

                const rendered = (markup.value || '').replace(/{{\s*([a-zA-Z0-9_.]+)\s*}}/g, function (match, path) {
                    const value = resolvePath(data, path);
                    return value === undefined || value === null ? match : String(value);
                });

                preview.innerHTML = rendered;
            }

            button.addEventListener('click', function () {
                const key = select.value;
                if (!key || !payload[key] || !target) return;
                target.value = payload[key];
                renderPreview();
            });

            target.addEventListener('input', renderPreview);
            markup.addEventListener('input', renderPreview);
            renderPreview();
        })();

        (function () {
            const input = document.getElementById('attachment-input');
            const dropzone = document.getElementById('attachment-dropzone');
            const list = document.getElementById('attachment-list');
            const status = document.getElementById('attachment-status');
            const listUrl = '@Url.Action("GetAttachments", "DesignTemplate", new { templateId = Model.Id })';
            const uploadUrl = '@Url.Action("UploadAttachment", "DesignTemplate", new { templateId = Model.Id })';
            const deleteUrl = '@Url.Action("DeleteAttachment", "DesignTemplate")';

            async function loadAttachments() {
                const response = await fetch(listUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                list.innerHTML = await response.text();
            }

            async function uploadFiles(files) {
                if (!files || files.length === 0) return;

                status.textContent = 'Uploading...';
                for (const file of files) {
                    const formData = new FormData();
                    formData.append('file', file);

                    const response = await fetch(uploadUrl, {
                        method: 'POST',
                        body: formData
                    });

                    if (!response.ok) {
                        status.textContent = 'Upload failed.';
                        return;
                    }
                }

                status.textContent = 'Upload complete.';
                input.value = '';
                await loadAttachments();
            }

            dropzone.addEventListener('click', function () {
                input.click();
            });

            dropzone.addEventListener('dragover', function (event) {
                event.preventDefault();
                dropzone.classList.add('bg-neutral-50');
            });

            dropzone.addEventListener('dragleave', function () {
                dropzone.classList.remove('bg-neutral-50');
            });

            dropzone.addEventListener('drop', function (event) {
                event.preventDefault();
                dropzone.classList.remove('bg-neutral-50');
                uploadFiles(event.dataTransfer.files);
            });

            input.addEventListener('change', function () {
                uploadFiles(input.files);
            });

            list.addEventListener('click', async function (event) {
                const button = event.target.closest('.attachment-delete');
                if (!button) return;

                const id = button.getAttribute('data-attachment-id');
                const response = await fetch(`${deleteUrl}?id=${encodeURIComponent(id)}`, { method: 'POST' });
                status.textContent = response.ok ? 'File deleted.' : 'Delete failed.';
                if (response.ok) {
                    await loadAttachments();
                }
            });

            loadAttachments();
        })();
    </script>
}
