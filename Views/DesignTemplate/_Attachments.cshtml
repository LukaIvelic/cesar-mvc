@model IEnumerable<cesar.Features.DesignTemplates.Models.DesignTemplateAttachmentDto>

@if (!Model.Any())
{
    <p class="empty-state py-4">No files uploaded.</p>
}
else
{
    <div class="table-wrap">
        <div class="divide-y divide-[#d8e0ea]">
            @foreach (var attachment in Model)
            {
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 px-4 py-3 text-sm">
                    <div class="min-w-0">
                        <a href="@attachment.FilePath" target="_blank" class="link-primary break-all">@attachment.FileName</a>
                        <p class="text-xs text-neutral-500 mt-1">@attachment.ContentType - @attachment.FileSize bytes - @attachment.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
                    </div>
                    <button type="button"
                            class="attachment-delete btn-danger"
                            data-attachment-id="@attachment.Id">
                        Delete
                    </button>
                </div>
            }
        </div>
    </div>
}
