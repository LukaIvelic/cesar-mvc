@model IEnumerable<cesar.Features.DesignTemplates.Models.DesignTemplateViewModel>

@{
    var columns = new[] { "ID", "Name", "Content Type", "Placeholder Schema", "Preview", "Actions" };
}

<div class="page-shell">
    <div class="page-header">
        <div>
            <p class="page-kicker">Rendering</p>
            <h2 class="page-title">Design Templates</h2>
            <p class="page-subtitle">Reusable output templates with JSON placeholders, previews, and attachments.</p>
        </div>
        <a asp-action="Create" class="btn-primary">Add Template</a>
    </div>

    <div class="search-panel">
        <label for="design-template-search" class="block text-sm font-medium mb-1">Search templates</label>
        <input id="design-template-search"
               type="search"
               class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black"
               placeholder="Search by name, content type or placeholder"
               data-ajax-search
               data-ajax-url="@Url.Action("Search", "DesignTemplate")"
               data-ajax-target="#design-template-rows" />
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    @foreach (var col in columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody id="design-template-rows">
                @await Html.PartialAsync("_Rows", Model)
            </tbody>
        </table>
    </div>
</div>
