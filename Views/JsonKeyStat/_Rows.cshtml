@model IEnumerable<cesar.Features.JsonKeyStats.Models.JsonKeyStatViewModel>

@if (!Model.Any())
{
    <tr>
        <td colspan="5" class="empty-cell">No key stats found.</td>
    </tr>
}
else
{
    @foreach (var stat in Model)
    {
        <tr>
            <td>@stat.Id</td>
            <td class="font-mono">@stat.Key</td>
            <td class="font-semibold">@stat.Occurrences</td>
            <td>@stat.ValidFrom.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                <div class="action-row">
                    <a asp-action="Edit" asp-route-id="@stat.Id" class="link-muted">Edit</a>
                    <form asp-action="Delete" asp-route-id="@stat.Id" method="post" onsubmit="return confirm('Soft delete this key?')">
                        <button type="submit" class="link-danger">Delete</button>
                    </form>
                </div>
            </td>
        </tr>
    }
}
