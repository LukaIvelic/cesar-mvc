@model IEnumerable<cesar.Features.JsonKeyStats.Models.JsonKeyStatViewModel>

@{
    var columns = new[] { "ID", "Key", "Occurrences", "Tracked Since", "Actions" };
}

<div class="page-shell page-shell-medium">
    <div class="page-header">
        <div>
            <p class="page-kicker">Schema signals</p>
            <h2 class="page-title">JSON Key Stats</h2>
            <p class="page-subtitle">Track recurring keys found across raw lead payloads.</p>
        </div>
        <a asp-action="Create" class="btn-primary">Add Key</a>
    </div>

    <div class="search-panel">
        <label for="json-key-search" class="block text-sm font-medium mb-1">Search keys</label>
        <input id="json-key-search"
               type="search"
               class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black"
               placeholder="Search by JSON key"
               data-ajax-search
               data-ajax-url="@Url.Action("Search", "JsonKeyStat")"
               data-ajax-target="#json-key-rows" />
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    @foreach (var col in columns)
                    {
                        <th>@col</th>
                    }
                </tr>
            </thead>
            <tbody id="json-key-rows">
                @await Html.PartialAsync("_Rows", Model)
            </tbody>
        </table>
    </div>
</div>
