@model IEnumerable<cesar.Features.LeadIntelligence.Models.LeadIntelligenceViewModel>

@{
    var columns = new[] { "ID", "Lead ID", "Content Hash", "Familiarity", "Density", "Last Analyzed", "Actions" };
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-semibold">Lead Intelligence</h2>
        <a asp-action="Create" class="bg-black text-white text-sm px-4 py-2 rounded hover:bg-neutral-800 transition">
            + Add Record
        </a>
    </div>

    <div class="mb-4">
        <label for="lead-intelligence-search" class="block text-sm font-medium mb-1">Search intelligence</label>
        <input id="lead-intelligence-search"
               type="search"
               class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black"
               placeholder="Search by ID, lead ID or hash"
               data-ajax-search
               data-ajax-url="@Url.Action("Search", "LeadIntelligence")"
               data-ajax-target="#lead-intelligence-rows" />
    </div>

    <table class="w-full border-collapse">
        <thead>
            <tr>
                @foreach (var col in columns)
                {
                    <th class="bg-[#efefef] border border-[#d0d0d0] px-4 py-2 text-left text-sm font-semibold">@col</th>
                }
            </tr>
        </thead>
        <tbody id="lead-intelligence-rows">
            @await Html.PartialAsync("_Rows", Model)
        </tbody>
    </table>
</div>
