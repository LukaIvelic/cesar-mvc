@model IEnumerable<cesar.Features.LeadIntelligence.Models.LeadIntelligenceViewModel>

@if (!Model.Any())
{
    <tr>
        <td colspan="7" class="empty-cell">No intelligence records found.</td>
    </tr>
}
else
{
    @foreach (var record in Model)
    {
        var hashPreview = record.ContentHash.Length > 16 ? $"{record.ContentHash[..16]}..." : record.ContentHash;
        <tr>
            <td>@record.Id</td>
            <td>@record.LeadId</td>
            <td class="font-mono text-xs">@hashPreview</td>
            <td>@record.FamiliarityIndex.ToString("F3")</td>
            <td>@record.DataDensityScore.ToString("F3")</td>
            <td>@record.LastAnalyzedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                <div class="action-row">
                    <a asp-action="Edit" asp-route-id="@record.Id" class="link-muted">Edit</a>
                    <form asp-action="Delete" asp-route-id="@record.Id" method="post" onsubmit="return confirm('Soft delete this record?')">
                        <button type="submit" class="link-danger">Delete</button>
                    </form>
                </div>
            </td>
        </tr>
    }
}
