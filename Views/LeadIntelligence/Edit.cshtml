@model cesar.Features.LeadIntelligence.Models.EditLeadIntelligenceModel

<div class="page-shell page-shell-narrow">
    <div class="page-header">
        <div>
            <p class="page-kicker">Analysis</p>
            <h2 class="page-title">Edit Intelligence #@Model.Id</h2>
            <p class="page-subtitle">Adjust the lead link, content hash, and analysis scores.</p>
        </div>
        <a asp-action="Index" class="back-link">Back to list</a>
    </div>

    <form asp-action="Edit" method="post" class="form-panel field-stack">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
        {
            ["FieldName"] = nameof(Model.LeadId),
            ["Label"] = "Raw Lead",
            ["SearchUrl"] = "/api/rawleads/autocomplete",
            ["SelectedValue"] = Model.LeadId > 0 ? Model.LeadId.ToString() : string.Empty,
            ["SelectedText"] = Model.LeadDisplayName,
            ["Placeholder"] = "Search by source or external ID",
            ["RequiredMessage"] = "Raw lead is required."
        })

        <div>
            <label asp-for="ContentHash" class="block text-sm font-medium mb-1">Content Hash (SHA256)</label>
            <input asp-for="ContentHash" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm font-mono focus:outline-none focus:border-black" />
            <span asp-validation-for="ContentHash" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div>
            <label asp-for="FamiliarityIndex" class="block text-sm font-medium mb-1">Familiarity Index <span class="text-neutral-400 font-normal">(0-1)</span></label>
            <input asp-for="FamiliarityIndex" type="number" step="0.001" min="0" max="1" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black" />
            <span asp-validation-for="FamiliarityIndex" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div>
            <label asp-for="DataDensityScore" class="block text-sm font-medium mb-1">Data Density Score <span class="text-neutral-400 font-normal">(0-1)</span></label>
            <input asp-for="DataDensityScore" type="number" step="0.001" min="0" max="1" class="w-full border border-[#d0d0d0] rounded px-3 py-2 text-sm focus:outline-none focus:border-black" />
            <span asp-validation-for="DataDensityScore" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <button type="submit" class="btn-primary self-start">
            Save Changes
        </button>
    </form>
</div>
